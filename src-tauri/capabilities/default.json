{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主視窗預設能力：核心 API 與視窗控制（純本機，無網路權限）。自訂 IPC 命令（含指標查詢）預設即獲授權；此處另明確允許事件監聽以訂閱 metrics://sample。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
